# ── Flask ──────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key
FLASK_ENV=development

# ── Database ───────────────────────────────────────────────────────────
# Leave unset for local development (falls back to SQLite).
# Required in production — Vercel's filesystem is not persistent.
# Example (Neon/Supabase/Vercel Postgres): postgresql://user:pass@host/db
DATABASE_URL=your_database_connection_string

# ── Google OAuth ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Only needed if the frontend is deployed on a different origin than the API.
CORS_ORIGINS=http://localhost:5173

# Where to send the browser after Google login completes.
FRONTEND_URL=http://localhost:5173
